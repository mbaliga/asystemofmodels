    "mode": "session",
    "lines": [
     "{\"t\":\"hello\",\"v\":1}",
     "{\"t\":\"lifecycle\",\"state\":\"active\"}",
     "{\"t\":\"borrow\",\"rid\":\"r-1\",\"model\":\"gpt-x\",\"messages\":[{\"role\":\"user\",\"content\":\"SECRET-PROMPT-7f3a91\"}],\"maxTokens\":16,\"stream\":true}",
     "{\"t\":\"peers\",\"op\":\"open\"}",
     "{\"t\":\"pair\",\"op\":\"begin\",\"value\":\"SECRET-QR-payload-91bc44\"}",
     "{\"t\":\"pair\",\"op\":\"confirm\",\"value\":\"SECRET-SAS-482113\"}",
     "{\"t\":\"cancel\",\"rid\":\"r-1\"}",
     "{\"t\":\"ledger\",\"since\":0,\"limit\":10}",
     "{\"t\":\"export\",\"kind\":\"ledger\"}",
     "{\"t\":\"revoke\",\"peer\":\"SECRET-PEER-0d5e\"}",
     "{\"t\":\"peers\",\"op\":\"close\"}",
     "{\"t\":\"shutdown\"}"
    ],
    "secrets": [
     "SECRET-PROMPT-7f3a91",
     "SECRET-QR-payload-91bc44",
     "SECRET-SAS-482113",
     "SECRET-PEER-0d5e"
    ],
    "child": false
   },
   "expect": {
    "ok": {
     "stdout": [
      "hello_ack",
      "state",
      "error",
      "state",
      "peers",
      "error",
      "error",
      "rows",
      "error",
      "error"
     ],
     "stderr": [],
     "exit": 0
    }
   }
  },
