      "status": "normative",
      "oracle": "self",
      "description": "Served-By only when both provider and model are known; Egress always",
      "input": {
        "servedProvider": "openrouter",
        "servedModel": "llama-3.3-70b",
        "egress": "cloud",
        "costEst": null,
        "costBasis": "none"
      },
      "expect": {
        "ok": {
          "X-Asom-Served-By": "openrouter/llama-3.3-70b",
          "X-Asom-Egress": "cloud"
        }
      }
    },
