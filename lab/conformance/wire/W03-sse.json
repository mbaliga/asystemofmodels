    {
      "id": "W03-005",
      "origin": "hand",
      "status": "normative",
      "oracle": "self",
      "description": "a final event without a terminating blank line is dropped and reported TRUNCATED",
      "input": {
        "request": {
          "path": "/v1/chat/completions",
          "body": {
            "model": "llama-3.3-70b",
            "stream": true,
            "messages": [
              {
                "role": "user",
                "content": "hello lab"
              }
            ]
          }
        },
        "keys": [
          "openrouter"
        ],
        "driver": {
          "default": {
            "kind": "stream",
            "chunksB64": [
              "ZGF0YTogeyJhIjoxfQoKZGF0YTogeyJiIjoyfQ=="
            ]
          }
        }
      },
      "expect": {
        "ok": {
          "bytesB64": "ZGF0YTogeyJhIjoxfQoKZGF0YTogeyJiIjoyfQ==",
          "events": [
