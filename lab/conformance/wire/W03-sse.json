        "request": {
          "path": "/v1/chat/completions",
          "body": {
            "model": "llama-3.3-70b",
            "stream": true,
            "messages": [
              {
                "role": "user",
                "content": "hello lab"
              }
            ]
          }
        },
        "keys": [
          "openrouter"
        ],
        "driver": {
          "default": {
            "kind": "stream",
            "chunksB64": [
              "ZGF0YTogeAoKZGF0YTogW0RPTkVdCgpkYXRhOiBsYXRlCgo="
