<?xml version="1.0" encoding="utf-8"?>
<!--
  Home-screen widget text styles. Secondary text is 12sp, body 14sp; every text
  slot is one line (two in the large layouts) and ellipsizes, so a 1.3-2x font
  scale clips cleanly instead of overlapping.
-->
<resources>
    <style name="AsomWidget" parent="">
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="AsomWidget.Title">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/widget_ink_dim</item>
    </style>

    <style name="AsomWidget.Meta">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/widget_ink_dim</item>
    </style>

    <style name="AsomWidget.Value">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AsomWidget.Value.Small">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="AsomWidget.Unit">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="AsomWidget.Headline">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AsomWidget.Line">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="AsomWidget.Line.Wrap">
        <item name="android:maxLines">2</item>
    </style>

    <style name="AsomWidget.Footer">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/widget_ink_dim</item>
        <item name="android:maxLines">2</item>
    </style>

    <style name="AsomWidget.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/widget_button_background</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
