<?xml version="1.0" encoding="utf-8"?>
<!-- The daemon widget's Start/Stop pad: a neutral outline; the label carries the meaning. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_hairline" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_ink_dim" />
    <corners android:radius="24dp" />
</shape>
