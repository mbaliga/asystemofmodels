<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (API 31+ previewLayout): sample content, drawn without data. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="@dimen/widget_padding_h"
    android:paddingTop="@dimen/widget_padding_v"
    android:paddingEnd="@dimen/widget_padding_h"
    android:paddingBottom="@dimen/widget_padding_v"
    tools:targetApi="31">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_title"
            style="@style/AsomWidget.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_last_route_title" />

        <TextView
            android:id="@+id/w_asof"
            style="@style/AsomWidget.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/widget_preview_time" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_headline"
        style="@style/AsomWidget.Headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_preview_route_headline"
        android:textColor="@color/widget_violet" />

    <TextView
        android:id="@+id/w_line1"
        style="@style/AsomWidget.Line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_preview_route_line1" />

    <TextView
        android:id="@+id/w_line2"
        style="@style/AsomWidget.Line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_preview_route_line2" />
</LinearLayout>
