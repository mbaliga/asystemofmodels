<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (API 31+ previewLayout): sample content, drawn without data. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="@dimen/widget_padding_h"
    android:paddingTop="@dimen/widget_padding_v"
    android:paddingEnd="@dimen/widget_padding_h"
    android:paddingBottom="@dimen/widget_padding_v"
    tools:targetApi="31">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_title"
            style="@style/AsomWidget.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_dl_title" />

        <TextView
            android:id="@+id/w_asof"
            style="@style/AsomWidget.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/widget_preview_time" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_value"
            style="@style/AsomWidget.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_downloads_value"
            android:textColor="@color/widget_violet" />

        <TextView
            android:id="@+id/w_unit"
            style="@style/AsomWidget.Unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/widget_preview_downloads_unit" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/w_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"
        android:max="100"
        android:progressBackgroundTint="@color/widget_hairline"
        android:progressTint="@color/widget_violet"
        android:indeterminateTint="@color/widget_violet"
        android:progress="42" />

    <TextView
        android:id="@+id/w_line1"
        style="@style/AsomWidget.Line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_preview_downloads_line1" />
</LinearLayout>
