<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".AsomApplication"
        android:label="asom"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Consent sheet (§5.7): launched by the client SDK from the CLIENT's
             foreground context; identity comes from the AIDL bind, never from
             extras. -->
        <activity
            android:name=".ui.PairingActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Dialog.NoActionBar">
            <intent-filter>
                <action android:name="xyz.mdhv.asom.PAIR_CONSENT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Discovery (§5.1): no permission — port/version/capabilities only,
             no secrets. -->
        <provider
            android:name=".discovery.DiscoveryProvider"
            android:authorities="xyz.mdhv.asom.discovery"
            android:exported="true" />

        <!-- Model file sharing (§5.8): read-only fd access, caller UID must
             map to an active pairing (checked in code, not by permission). -->
        <provider
            android:name=".storage.ModelsProvider"
            android:authorities="xyz.mdhv.asom.models"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!-- Ledger export (§9 / §1.1): the ONE sanctioned egress action in v1.
             Not exported — the receiving app only ever gets the one-shot read
             grant carried by the user's own share intent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="xyz.mdhv.asom.export"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- FGS type specialUse with the property declaration (brief §3):
             sideload-first distribution; Play justification is a later owner
             concern. -->
        <service
            android:name=".service.AsomService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local-only (127.0.0.1) OpenAI-compatible model routing daemon serving paired apps on this device" />
        </service>

        <!-- Boot-start toggle (§11 P8): default OFF, checked at receive time. -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widgets (docs/widgets.md). Providers are exported so any
             launcher can bind them; they show ledger metadata and counts only,
             never keys, tokens, bodies or paired-app names. TIME_SET,
             TIMEZONE_CHANGED and LOCALE_CHANGED redraw their times and words. -->
        <receiver
            android:name=".widget.EgressTodayWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_egress">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_egress" />
        </receiver>

        <receiver
            android:name=".widget.DaemonWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_daemon">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_daemon" />
        </receiver>

        <receiver
            android:name=".widget.LastRouteWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_last_route">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_last_route" />
        </receiver>

        <receiver
            android:name=".widget.RecentRoutesWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_recent_routes">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_recent_routes" />
        </receiver>

        <receiver
            android:name=".widget.HotspotWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_hotspot">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_hotspot" />
        </receiver>

        <receiver
            android:name=".widget.DownloadsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_downloads">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_downloads" />
        </receiver>

        <!-- Midnight redraw for the widgets' "today"; only asom's own alarm reaches it. -->
        <receiver
            android:name=".widget.WidgetTickReceiver"
            android:exported="false" />

        <!-- The daemon widget's Start/Stop pad: an activity because Android 12+
             refuses foreground-service starts from the background. Shows
             nothing and finishes at once. -->
        <activity
            android:name=".widget.WidgetActionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Quick-settings tile (§11 P8): start/stop from the shade. -->
        <service
            android:name=".service.AsomTileService"
            android:exported="true"
            android:icon="@android:drawable/stat_notify_sync_noanim"
            android:label="asom"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
