<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- The AI hotspot (§5.7): exported bound service; consent is enforced
             by the flow itself (verified identity + user approval), binding
             alone grants nothing. -->
        <service
            android:name="xyz.mdhv.asom.pairing.PairingService"
            android:exported="true">
            <intent-filter>
                <action android:name="xyz.mdhv.asom.PAIR" />
            </intent-filter>
        </service>
    </application>

</manifest>
